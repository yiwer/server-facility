# 行尾归一:仓库内文本一律 LF,防跨平台(Windows CRLF)漂移
* text=auto eol=lf

*.java     text eol=lf
*.xml      text eol=lf
*.properties text eol=lf
*.md       text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.txt      text eol=lf
*.imports  text eol=lf
*.config   text eol=lf

# 二进制:不做行尾转换
*.jar  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
